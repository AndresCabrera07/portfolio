---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
  lang?: "es" | "en";
}

const { projects, lang = "es" } = Astro.props;
---

<Section text={lang === "es" ? "Proyectos" : "Projects"} href="projects">
  <div class="flex flex-col gap-10">
    {
      projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
        const top = 90 + index * 30;
        return (
          <div
            style={`top: ${top}px;`}
            class="sticky rounded-2xl border border-neutral/20 bg-black shadow-xl"
          >
            <div class="relative z-1 flex flex-col justify-between overflow-hidden rounded-2xl bg-[#1c232d]/90 p-6 md:grid md:grid-cols-2 md:gap-8 md:p-8">
              <!-- Información del Proyecto -->
              <div class="flex flex-col justify-between z-10">
                <div>
                  <h3 class="mb-3 font-serif text-2xl md:text-3xl font-medium text-primary">
                    {name}
                  </h3>
                  <p class="mb-6 text-sm md:text-base leading-relaxed text-neutral">
                    {summary}
                  </p>
                </div>

                <!-- Botones de Acción -->
                <div class="flex items-center gap-6 mb-6 md:mb-0 text-sm font-semibold text-white">
                  {linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1.5 transition-colors hover:text-primary after:content-[url(/external.svg)]"
                    >
                      {lang === "es" ? "Código" : "Source"}
                    </a>
                  )}
                  {linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1.5 transition-colors hover:text-primary after:content-[url(/external.svg)]"
                    >
                      {lang === "es" ? "Ver Demo" : "Preview"}
                    </a>
                  )}
                </div>
              </div>

              <!-- Imagen del Proyecto -->
              <div class="relative mt-2 md:mt-0 flex items-center justify-center overflow-hidden rounded-xl border border-white/10 bg-slate-900/50">
                <Image
                  class="w-full h-auto max-h-60 md:max-h-full object-cover object-top transition-transform duration-300 hover:scale-105"
                  src={image}
                  alt={name}
                  width="736"
                  height="483"
                />
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Section>