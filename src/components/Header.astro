---
import Menu from "@icons/Menu.astro";
import { Image } from "astro:assets";
import type { HeaderProps } from "@types";

interface Props extends HeaderProps {
  lang?: "es" | "en";
}

const { siteLogo, navLinks, lang = "es" } = Astro.props;
---

<header
  class="sticky top-0 z-50 mx-auto flex max-w-5xl items-center justify-between bg-black/90 backdrop-blur-md px-5 py-4"
>
  <a href={lang === "es" ? "/" : "/en"} aria-label="Home link">
    <Image
      class="rounded-full object-cover"
      src={siteLogo}
      width="40"
      height="40"
      alt="website logo"
      priority
    />
  </a>

  <!-- Contenedor derecho: Switch de Idioma + Botón Móvil / Menú -->
  <div class="flex items-center gap-4">
    <!-- Selector de Idioma Integrado -->
    <div class="flex items-center gap-1.5 rounded-full border border-neutral/30 bg-[#1e293b]/70 px-3 py-1 text-xs font-semibold">
      {
        lang === "es" ? (
          <>
            <span class="text-primary font-bold">ES</span>
            <span class="text-neutral/40">/</span>
            <a href="/en" class="text-neutral hover:text-white transition-colors">EN</a>
          </>
        ) : (
          <>
            <a href="/" class="text-neutral hover:text-white transition-colors">ES</a>
            <span class="text-neutral/40">/</span>
            <span class="text-primary font-bold">EN</span>
          </>
        )
      }
    </div>

    <!-- Botón Menú Móvil -->
    <button
      type="button"
      id="menu-button"
      class="p-1 text-neutral sm:hidden hover:text-white"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <Menu />
    </button>
  </div>

  <!-- Navegación Desktop / Desplegable Móvil -->
  <nav
    class="absolute top-16 right-5 hidden rounded-xl border border-neutral/40 bg-black/95 px-5 py-5 text-neutral backdrop-blur-lg sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
    id="main-menu"
  >
    <ul class="flex flex-col gap-3 sm:flex-row sm:gap-4 items-start sm:items-center">
      {
        navLinks.map((link) => {
          const isPdf = link.href.endsWith(".pdf");
          return (
            <li class="relative w-full sm:w-auto">
              <a
                class={`nav-item block py-1 text-sm font-medium transition-all duration-300 hover:text-white ${
                  isPdf ? "text-primary font-semibold hover:underline" : ""
                }`}
                href={link.href}
                target={isPdf ? "_blank" : undefined}
                download={isPdf ? "HV_Andres_Cabrera.pdf" : undefined}
                rel={isPdf ? "noopener noreferrer" : undefined}
              >
                {link.text}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu a");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", () => {
      if (window.innerWidth < 640) {
        menu?.classList.add("hidden");
        button?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>