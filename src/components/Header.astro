---
import Menu from "@icons/Menu.astro";
import { Image } from "astro:assets";
import type { HeaderProps } from "@types";

interface Props extends HeaderProps {
  lang?: "es" | "en";
}

const { siteLogo, navLinks, lang = "es" } = Astro.props;
---

<header
  class="sticky top-0 z-50 mx-auto flex max-w-5xl items-center justify-between bg-black/90 px-5 py-4 backdrop-blur-md"
>
  <!-- Logo -->
  <a href={lang === "es" ? "/" : "/en"} aria-label="Home link">
    <Image
      class="rounded-full object-cover"
      src={siteLogo}
      width="42"
      height="42"
      alt="website logo"
      priority
    />
  </a>

  <!-- Zona Derecha: Idioma + Menú -->
  <div class="flex items-center gap-3">
    <!-- Switch de idioma -->
    <div
      class="flex items-center gap-1.5 rounded-full border border-neutral/30 bg-slate-900/80 px-3 py-1 text-xs font-semibold text-neutral"
    >
      {
        lang === "es" ? (
          <>
            <span class="text-primary font-bold">ES</span>
            <span class="opacity-40">/</span>
            <a href="/en" class="transition hover:text-white">EN</a>
          </>
        ) : (
          <>
            <a href="/" class="transition hover:text-white">ES</a>
            <span class="opacity-40">/</span>
            <span class="text-primary font-bold">EN</span>
          </>
        )
      }
    </div>

    <!-- Botón Móvil -->
    <button
      type="button"
      id="menu-button"
      class="p-2 text-neutral transition hover:text-white sm:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label="Abrir menú"
    >
      <Menu />
    </button>
  </div>

  <!-- Navegación -->
  <nav
    class="absolute top-full right-5 left-5 hidden mt-2 rounded-2xl border border-neutral/40 bg-black/95 p-5 text-neutral backdrop-blur-xl sm:static sm:block sm:w-auto sm:border-0 sm:bg-transparent sm:p-0 sm:left-auto sm:right-auto sm:mt-0"
    id="main-menu"
  >
    <ul class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      {
        navLinks.map((link) => {
          const isPdf = link.href.endsWith(".pdf");
          return (
            <li class="relative">
              <a
                class={`nav-item block text-sm font-medium transition-colors hover:text-white ${
                  isPdf ? "font-semibold text-primary" : ""
                }`}
                href={link.href}
                target={isPdf ? "_blank" : undefined}
                download={isPdf ? "HV_Andres_Cabrera_Cuadro.pdf" : undefined}
                rel={isPdf ? "noopener noreferrer" : undefined}
              >
                {link.text}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu a");

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  navItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (window.innerWidth < 640) {
        menu?.classList.add("hidden");
      }
    });
  });
</script>